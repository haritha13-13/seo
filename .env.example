# LiteLLM-style model string. Ollama cloud API: ollama/gpt-oss:120b at https://ollama.com (key required).
# Local Ollama: ollama/llama3.1:8b at http://localhost:11434 (leave the key empty).
PORTAL_AUTO_LLM_MODEL=ollama/gpt-oss:120b
PORTAL_AUTO_LLM_BASE_URL=https://ollama.com
PORTAL_AUTO_LLM_API_KEY=
# For OpenAI/Anthropic set only the model string, clear BASE_URL, and set OPENAI_API_KEY / ANTHROPIC_API_KEY.

# Credentials are referenced in workflows as {{ENV:NAME}}
DEMO_USER=tomsmith
DEMO_PASS=SuperSecretPassword!

# --- Web app ---
# Fernet key that encrypts stored portal passwords. Generate once and KEEP it (losing it makes passwords unrecoverable):
#   ./venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_AUTO_VAULT_KEY=
PORTAL_AUTO_DATABASE_URL=sqlite:///portal_auto.db
PORTAL_AUTO_RUN_TIMEOUT_SECONDS=600
PORTAL_AUTO_AGENT_MAX_ITERATIONS=40

# Folder holding one private Chrome profile per Credential for Capture (default ~/.portal-auto/chrome-profiles; "temp" = throwaway profile each time)
# PORTAL_AUTO_CHROME_PROFILES_DIR=
